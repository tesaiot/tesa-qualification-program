import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import RoadmapView from '../components/RoadmapView.astro';
import { roadmapHeadings } from '../lib/data';
import { S } from '../lib/strings';

const lang = 'th';
const t = S[lang];
---

<StarlightPage frontmatter={{ title: t.roadmapTitle, description: t.roadmapDesc }} headings={roadmapHeadings(lang)}>
	<RoadmapView lang={lang} />
</StarlightPage>
