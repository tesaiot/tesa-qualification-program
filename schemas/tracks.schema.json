{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tesa:open-knowledge:schema:tracks",
  "title": "Learning pathways (catalog/tracks.yaml)",
  "description": "Pathways through the catalog. Course/module references are checked by tools/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "audience",
          "summary",
          "hours",
          "steps",
          "exit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "$ref": "#/$defs/i18n"
          },
          "audience": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "summary": {
            "$ref": "#/$defs/i18n"
          },
          "hours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "course"
              ],
              "properties": {
                "course": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "modules": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^m[0-9]{2}(?:-[a-z0-9]+(?:-[a-z0-9]+)*)?$"
                      },
                      {
                        "type": "integer",
                        "minimum": 1
                      }
                    ]
                  }
                },
                "note": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/i18n_th"
                    }
                  ]
                }
              }
            }
          },
          "exit": {
            "$ref": "#/$defs/i18n"
          }
        }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "description": "Thai + English text",
      "required": [
        "th",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "th": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "i18n_th": {
      "type": "object",
      "description": "Thai text, English optional",
      "required": [
        "th"
      ],
      "additionalProperties": false,
      "properties": {
        "th": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
