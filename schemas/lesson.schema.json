{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tesa:open-knowledge:schema:lesson",
  "title": "Lesson front matter (README.md / README.en.md of courses/<id>/mNN-*/lNN-*/)",
  "description": "BUILD_SPEC §4. The EN file repeats the TH front matter with lang: en (and may add source_sha256).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "lang",
    "title",
    "summary",
    "level",
    "time_min",
    "hardware",
    "prerequisites",
    "objectives",
    "develops",
    "context",
    "status",
    "translation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.m[0-9]{2}\\.l[0-9]{2}$"
    },
    "lang": {
      "enum": [
        "th",
        "en"
      ]
    },
    "title": {
      "$ref": "#/$defs/i18n"
    },
    "summary": {
      "$ref": "#/$defs/i18n"
    },
    "level": {
      "type": "string",
      "pattern": "^L[1-5]$"
    },
    "time_min": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "minutes; the TOTAL must be 10-240 (checked by tools/validate.py: above 75 is a warning unless the lesson folder is a lab)",
      "properties": {
        "concept": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240
        },
        "practise": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240
        },
        "lab": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240
        },
        "check": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240
        }
      }
    },
    "hardware": {
      "$ref": "#/$defs/hardware"
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.m[0-9]{2}\\.l[0-9]{2}$"
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/i18n"
      }
    },
    "develops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "to"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "to": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "assesses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "level",
          "evidence"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "context": {
      "type": "object",
      "description": "free-form (platform, lang, ide, ...)"
    },
    "status": {
      "enum": [
        "pre-alpha",
        "alpha",
        "beta",
        "stable"
      ]
    },
    "translation": {
      "enum": [
        "done",
        "pending"
      ]
    },
    "slides": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(/|[a-z][a-z0-9+.-]*:)"
      }
    },
    "source": {
      "description": "free-form provenance",
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      ]
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "EN file only: sha256 of the Thai README.md body it translates"
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "description": "Thai + English text",
      "required": [
        "th",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "th": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "i18n_th": {
      "type": "object",
      "description": "Thai text, English optional",
      "required": [
        "th"
      ],
      "additionalProperties": false,
      "properties": {
        "th": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emulator",
        "boards"
      ],
      "properties": {
        "emulator": {
          "type": "boolean"
        },
        "boards": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "eva-kit",
              "devkit",
              "none"
            ]
          }
        }
      }
    }
  }
}
