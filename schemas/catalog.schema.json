{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tesa:open-knowledge:schema:catalog",
  "title": "Course catalog (catalog/courses.yaml)",
  "description": "Every course TESA Open Knowledge knows about. in_tree courses live in courses/<id>/; external ones are pinned to a ref.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "courses"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "short",
          "in_tree",
          "level",
          "status",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "short": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "in_tree": {
            "type": "boolean"
          },
          "level": {
            "type": "string",
            "pattern": "^L[1-5]$"
          },
          "status": {
            "enum": [
              "pre-alpha",
              "alpha",
              "beta",
              "stable"
            ]
          },
          "title": {
            "$ref": "#/$defs/i18n"
          },
          "note": {
            "type": "string"
          },
          "external": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "ref",
              "license"
            ],
            "properties": {
              "repo": {
                "type": "string",
                "pattern": "^https?://\\S+$"
              },
              "site": {
                "type": "string",
                "pattern": "^https?://\\S+$"
              },
              "ref": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,40}$|^v?[0-9][0-9A-Za-z.+-]*$"
              },
              "license": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content",
                  "code"
                ],
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "if": {
          "properties": {
            "in_tree": {
              "const": false
            }
          }
        },
        "then": {
          "required": [
            "external"
          ]
        }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "description": "Thai + English text",
      "required": [
        "th",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "th": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "i18n_th": {
      "type": "object",
      "description": "Thai text, English optional",
      "required": [
        "th"
      ],
      "additionalProperties": false,
      "properties": {
        "th": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
