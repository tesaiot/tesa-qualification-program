{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tesa:open-knowledge:schema:roles",
  "title": "Role profile (skills/roles/<id>.yaml)",
  "description": "A role promotes skills to a target level. Skill ids are checked against skills/skills.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "target_level",
    "requires"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "$ref": "#/$defs/i18n"
    },
    "summary": {
      "$ref": "#/$defs/i18n"
    },
    "target_level": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^L[1-5]$"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      ]
    },
    "requires": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "level"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "promoted_from": {
            "description": "roadmap importance before the role promoted it",
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "anchors": {
      "description": "free-form references (TPQI units, job profiles, ...)"
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "description": "Thai + English text",
      "required": [
        "th",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "th": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "i18n_th": {
      "type": "object",
      "description": "Thai text, English optional",
      "required": [
        "th"
      ],
      "additionalProperties": false,
      "properties": {
        "th": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
