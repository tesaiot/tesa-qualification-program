    title: "AIoT in Action — Embedded Systems for AIoT Developer"
    authors:
      - family-names: Sriborrirux
        given-names: Wiroon
        affiliation: "Advance Innovation Centre (AIC), Burapha University"
    repository-code: "https://github.com/Advance-Innovation-Centre-AIC/embedded-systems-for-aiot-developer"
    year: 2026
    notes: "Content CC-BY-4.0, code MIT. Source of courses/aiot-micropython/."
  - type: generic
    title: "TESAIoT Training Handbooks (C1–C3)"
    authors:
      - alias: drsanti
    repository-code: "https://github.com/drsanti/TESAIoT-Courses"
    notes: "Original course material produced with funding from TESA."
  - type: generic
    title: "Embedded Systems Engineering Roadmap"
    authors:
      - family-names: Parvizi
        given-names: Meysam
    repository-code: "https://github.com/m3y54m/Embedded-Engineering-Roadmap"
